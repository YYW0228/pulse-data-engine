# Pulse Data Engine — 环境变量模板
# 复制为 .env 并填入真实值
#
# 用法:
#   cp .env.example .env
#   # 编辑 .env 填入 secret
#   uv run python scripts/run_production.py

# ── Cloudflare R2 ──────────────────────────────────────────────────
# 用于 Parquet 冷存储 + Worker 代理
# 获取: Cloudflare Dashboard → R2 → Bucket → 设置 → API Tokens
CF_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_r2_api_token_here

# ── Slack 通知 (可选) ──────────────────────────────────────────────
# 管道失败时发送通知
# 创建: Slack App → Incoming Webhooks → 复制 URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/xxx

# ── LLM 增强 (可选) ────────────────────────────────────────────────
# 用于 AI 职位解析 (P4 特性)
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx
