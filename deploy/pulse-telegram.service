[Unit]
Description=Pulse Data Engine - Telegram 消息轮询
After=network.target

[Service]
WorkingDirectory=/root/projects/pulse-data-engine
ExecStart=/root/projects/pulse-data-engine/.venv/bin/python -m scripts.telegram_poller
Restart=always
RestartSec=5
Environment=PYTHONPATH=/root/projects/pulse-data-engine

[Install]
WantedBy=multi-user.target
