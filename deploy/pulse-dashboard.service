[Unit]
Description=Pulse Data Engine - AI 人才市场情报 Dashboard
After=network.target

[Service]
WorkingDirectory=/root/projects/pulse-data-engine
ExecStart=/root/projects/pulse-data-engine/.venv/bin/streamlit run serve.py --server.port 8501 --server.headless true --server.address 0.0.0.0
Restart=always
RestartSec=3
Environment=PYTHONPATH=/root/projects/pulse-data-engine
Environment=HOME=/root

[Install]
WantedBy=multi-user.target
